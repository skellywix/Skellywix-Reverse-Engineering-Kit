  "schema": 1,
  "revision": 3,
  "reviewed": true,
  "review": {
    "date": "2026-11-25",
    "basis": "The checkout specifies publishers and update channels, not the current release. Each install records its exact inputs separately. Fixed compatibility inputs identify a specific qualification contract."
  },
  "distribution": {
    "portable": true,
    "needs": [
      "Docker Engine with Linux containers and the Buildx plugin",
      "Network access to Docker Hub, Debian mirrors, npm, crates.io, and GitHub during an update"
    ],
    "never_installed_by_update": [
      "Operator-supplied inputs (the Fourmilab reference program and the Neverball Windows release): they are verified when present and reported when absent",
      "CI actions follow their declared major release on GitHub; they are not installed on a workstation",
      "Host packages: no OS package manager is used on the host"
    ],
    "notes": [
      "Cargo and npm resolve compatible registry releases inside containers. npm lifecycle scripts are disabled. Workspace builds consume the installed set offline.",
      "The Neverball runner is built locally from a digest-pinned base and a hash-pinned recipe. Its apt layer is version-pinned but not bit-reproducible, so its image ID is recorded at install time instead of being fixed in advance."
    ]
  },
