{
  "mcpServers": {
    "rea": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/opt/rea/scripts/rea.mjs",
        "mcp"
      ],
      "env": {
        "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
        "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off",
        "GHIDRA_INSTALL_DIR": "/opt/ghidra",
        "JAVA_HOME": "/opt/jdk"
      }
    }
  }
}
